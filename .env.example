# Production: the only supported path. Your server holds the Azure key.
VITE_TTS_PROXY_URL=/api/tts

# DEVELOPMENT ONLY. These are read exclusively when import.meta.env.DEV is true
# and are compiled out of production builds. Never put a real key in a deployed
# bundle -- anything the browser can read, every visitor can read.
# VITE_DEV_AZURE_KEY=
# VITE_DEV_AZURE_REGION=eastus
